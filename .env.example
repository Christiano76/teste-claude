# ---- Banco de dados (PostgreSQL / Supabase) ----
# Local: postgres://postgres:postgres@localhost:5432/pchunter
# Supabase: Project Settings → Database → Connection string (use o pooler, porta 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pchunter
DATABASE_SSL=false

# ---- Agendamento ----
# Vercel Cron envia "Authorization: Bearer $CRON_SECRET" para /api/cron/refresh
CRON_SECRET=troque-por-um-valor-aleatorio
CRON_PAGES=10
SEARCH_CACHE_MINUTES=30
ON_DEMAND_PAGES=2
APP_URL=http://localhost:3000

# ---- Estimativa de impostos de importação ----
IMPORT_ICMS_RATE=0.20

# ---- Brave Search API (descoberta de anúncios em OLX, Mercado Livre, Amazon, lojas pequenas...) ----
# Chave do painel https://api-dashboard.search.brave.com — SOMENTE no servidor (.env.local ou variáveis da Vercel).
BRAVE_SEARCH_API_KEY=
BRAVE_CACHE_HOURS=12
BRAVE_RPS=5
BRAVE_MAX_QUERIES_PER_SEARCH=40

# CEP padrão de entrega (usado quando o usuário não informa)
DEFAULT_CEP=71572811

# ---- Fontes de ofertas ----
# KaBuM!: funciona sem credenciais (catálogo público). Desative com false.
KABUM_ENABLED=true

# Mercado Livre (API oficial; busca exige OAuth) — developers.mercadolivre.com.br
ML_ACCESS_TOKEN=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Amazon PA-API 5 (programa de Associados)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# eBay Browse API (entrega para o Brasil confirmada pelo filtro deliveryCountry:BR)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# AliExpress Affiliate API (portals.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Shopee Affiliate Open API
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Feeds de produtos (Google Merchant XML / CSV / JSON) — ex.: feeds de afiliados de Pichau, Terabyte, Magalu
# PRODUCT_FEEDS=[{"store":"Pichau","url":"https://exemplo/feed.xml","origin":"BR"}]
PRODUCT_FEEDS=

# ---- Alertas por e-mail (opcional) ----
RESEND_API_KEY=
ALERT_EMAIL_FROM=PC Hunter <alertas@seudominio.com>
